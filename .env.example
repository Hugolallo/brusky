# ── Brusky — environment variables ────────────────────────────────────────────
# Copy to .env and fill in your values. Never commit .env to git.

# ── Infrastructure ─────────────────────────────────────────────────────────────
# Set strong, unique passwords before running docker compose up.
NEO4J_PASSWORD=
REDIS_PASSWORD=

# ── Model selection ────────────────────────────────────────────────────────────
# These are fallbacks. The primary config lives in config/models.yaml.
# Valid providers: anthropic | openai | ollama | groq | mistral | azure | bedrock
LLM_PROVIDER=anthropic
LLM_MODEL=claude-sonnet-4-6

# ── API keys — only provide the key for your chosen provider ──────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GROQ_API_KEY=
MISTRAL_API_KEY=

# ── Ollama (local models — no API key needed) ──────────────────────────────────
# Run Ollama on your host, then set:
# OLLAMA_API_BASE=http://host.docker.internal:11434
OLLAMA_API_BASE=

# ── Azure OpenAI ───────────────────────────────────────────────────────────────
AZURE_API_KEY=
AZURE_API_BASE=
AZURE_API_VERSION=2024-02-01

# ── Output channels (optional) ─────────────────────────────────────────────────
SLACK_WEBHOOK_URL=
PAGERDUTY_API_KEY=
GITHUB_TOKEN=

# ── Bitbucket integration ───────────────────────────────────────────────────────
# Secret you set in Bitbucket: repo > Settings > Webhooks > Add webhook > Secret
BITBUCKET_WEBHOOK_SECRET=
# App Password with repo:read scope — create at bitbucket.org > Personal settings > App passwords
BITBUCKET_ACCESS_TOKEN=
# Your Bitbucket workspace slug (appears in repo URLs: bitbucket.org/<workspace>/...)
BITBUCKET_WORKSPACE=
